# Set to true on HTTPS, false for local http
COOKIE_SECURE=true

# Public site
NEXT_PUBLIC_SITE_URL=https://vermontavenuerecords.com

# Booking email (Resend)
RESEND_API_KEY=
BOOKING_TO_EMAIL=
RESEND_FROM=Vermont Avenue Records <onboarding@resend.dev>

# Analytics
NEXT_PUBLIC_GA_ID=
